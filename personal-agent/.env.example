# Wszystkie te ustawienia możesz też zmienić w dashboardzie: zakładka Ustawienia.

# ===== Mózg agenta =====
# ollama = darmowy model lokalny na Twoim komputerze (domyślnie), claude = chmura (płatny, najmądrzejszy)
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# qwen3:8b (zalecany, ~5 GB), qwen3:4b (słabszy komputer), qwen3:14b (mocny komputer z GPU)
OLLAMA_MODEL=qwen3:8b
# model do oceniania zdjęć
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_CTX=16384

# ===== Claude (opcjonalnie) =====
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (wyżej = dokładniej, drożej, wolniej)
AGENT_EFFORT=medium
# 1 = gdy model odmówi, API automatycznie spróbuje innym modelem
AGENT_FALLBACKS=1

# ===== Telegram =====
# 1) Napisz do @BotFather -> /newbot -> skopiuj token tutaj
TELEGRAM_BOT_TOKEN=
# 2) Uruchom agenta, napisz do bota /start, potem w dashboardzie: Ustawienia -> "Dodaj ten czat"
#    (albo wpisz chat_id ręcznie, kilka po przecinku)
TELEGRAM_ALLOWED_CHAT_IDS=

# ===== Ty =====
USER_NAME=Norbert
# Krótki opis; pełny profil (firma Stratfanat, strony WWW, teledyski, foto...) jest w pliku profil.md
USER_PROFILE=
TIMEZONE=Europe/Warsaw

LOCATION=Warszawa

# ===== Głos i rozmowa =====
# Głos agenta: pl-PL-ZofiaNeural (kobiecy) albo pl-PL-MarekNeural (męski)
VOICE_NAME=pl-PL-ZofiaNeural
# edge = naturalny głos (wymaga internetu), browser = głos systemu
VOICE_TTS=edge
# browser = rozpoznawanie mowy Chrome/Edge, whisper = lokalnie (pip install -r requirements-voice.txt)
VOICE_STT=browser
WHISPER_MODEL=small
# 1 = na głosówki z Telegrama odpowiadaj też głosem
TELEGRAM_VOICE_REPLY=1

# ===== Pliki na komputerze, które agent ma znać =====
# Foldery oddzielone średnikiem, np. Windows:
# WATCH_FOLDERS=D:\Zdjecia;D:\Teledyski;C:\Users\Norbert\Desktop
WATCH_FOLDERS=
# 1 = czytaj EXIF zdjęć (aparat, obiektyw, ISO, data zrobienia)
INDEX_EXIF=1

# ===== Harmonogram =====
MORNING_BRIEF_ENABLED=1
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=0
# ile minut przed wydarzeniem wysłać przypomnienie
REMINDER_MINUTES=60

# ===== Krypto (ID z CoinGecko) =====
CRYPTO_WATCHLIST=bitcoin,ethereum,solana
# co ile minut sprawdzać alerty cenowe
CRYPTO_CHECK_MINUTES=5

# ===== Dashboard =====
HOST=127.0.0.1
PORT=8765
